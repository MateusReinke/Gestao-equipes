generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  clt
  pj
  terceirizado
  estagio
}

enum WorkModel {
  presencial
  hibrido
  remoto
}

enum ScaleType {
  doze_por_trinta_seis
  cinco_por_dois
  personalizada
}

enum OnCallType {
  plantao
  sobreaviso
}

enum VacationStatus {
  pendente
  aprovado
  rejeitado
  cancelado
}

enum ShiftType {
  turno
  plantao
  sobreaviso
}

enum ShiftStatus {
  planejado
  confirmado
  trocado
  cancelado
}

enum SwapType {
  troca
  cobertura
}

enum SwapStatus {
  pendente
  aceito_pelo_par
  aprovado
  rejeitado
  cancelado
}

enum AbsenceType {
  falta
  atestado
  licenca
  folga
  banco_horas
  outro
}

enum AbsenceStatus {
  pendente
  aprovado
  rejeitado
}

enum PermissionEffect {
  grant
  deny
}

/// Tipos de recurso que podem ser compartilhados.
enum ShareResourceType {
  dashboard
  escala
  relatorio
}

/// Para quem o recurso foi compartilhado.
enum ShareScope {
  usuario
  equipe
  papel
  tenant
  link_publico
  plataforma
}

/// Quanto o destinatário pode fazer com o recurso compartilhado.
enum ShareAccess {
  leitura
  edicao
  gestao
}

enum DashboardVisibility {
  privado
  compartilhado
}

enum NotificationSeverity {
  info
  aviso
  critico
}

enum NotificationType {
  ferias_direito_adquirido
  ferias_prazo_proximo
  ferias_prazo_critico
  ferias_vencida
  ferias_pendente_aprovacao
  ausencia_pendente_aprovacao
  troca_pendente_aprovacao
}

enum AuditAction {
  create
  update
  delete
  login
  login_failed
  permission_change
  swap_request
  swap_response
}

model Tenant {
  id        Int      @id @default(autoincrement())
  nome      String
  slug      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       TenantMembership[]
  papeis            Role[]
  overrides         UserPermissionOverride[]
  clientes          Client[]
  equipes           Team[]
  colaboradores     Collaborator[]
  gestorEquipes     ManagerTeam[]
  escalas           Scale[]
  escalaAtribuicoes ScaleAssignment[]
  escalaDetalhes    ScaleDetail[]
  plantoes          OnCall[]
  turnos            Shift[]
  trocas            ShiftSwap[]
  ferias            Vacation[]
  ausencias         Absence[]
  auditoria         AuditLog[]
  compartilhamentos ShareGrant[]
  dashboards        Dashboard[]
  ajustesFerias     VacationAdjustment[]
  notificacoes      Notification[]

  diretorioConexoes      DirectoryConnection[]
  diretorioPessoas       DirectoryPerson[]
  diretorioDepartamentos DirectoryDepartment[]
  diretorioCargos        DirectoryJobTitle[]
  diretorioExecucoes     DirectorySyncRun[]

  @@map("tenants")
}

/// Identidade global do usuário (um único login/e-mail na plataforma).
/// O vínculo com cada tenant - e o papel dentro dele - vive em TenantMembership.
/// isGlobalAdmin marca o Administrador Global (escopo de plataforma, não depende de vínculo).
model User {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  senhaHash     String   @map("senha_hash")
  ativo         Boolean  @default(true)
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships                TenantMembership[]
  gestorEquipes              ManagerTeam[]
  overrides                  UserPermissionOverride[]
  auditoria                  AuditLog[]
  feriasSolicitadas          Vacation[]               @relation("VacationRequester")
  feriasRespondidas          Vacation[]               @relation("VacationApprover")
  ausenciasRespondidas       Absence[]                @relation("AbsenceApprover")
  trocasRespondidas          ShiftSwap[]              @relation("SwapResponder")
  compartilhamentosRecebidos ShareGrant[]             @relation("ShareTargetUser")
  compartilhamentosCriados   ShareGrant[]             @relation("ShareCreator")
  dashboards                 Dashboard[]              @relation("DashboardOwner")
  dashboardVersoes           DashboardVersion[]       @relation("DashboardVersionAuthor")
  dashboardFavoritos         DashboardFavorite[]
  notificacoes               Notification[]           @relation("NotificationTarget")
  ajustesFeriasRegistrados   VacationAdjustment[]     @relation("VacationAdjustmentAuthor")
  sincronizacoesDisparadas   DirectorySyncRun[]       @relation("DirectorySyncTrigger")

  @@map("usuarios")
}

/// Catálogo global e imutável de permissões nomeadas da plataforma.
model Permission {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  categoria String

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([categoria])
  @@map("permissoes")
}

/// Papel (cargo). tenantId nulo = papel de sistema, disponível para todos os tenants.
/// tenantId preenchido = papel customizado criado por aquele tenant.
model Role {
  id        Int      @id @default(autoincrement())
  tenantId  Int?     @map("tenant_id")
  codigo    String
  nome      String
  descricao String
  isSystem  Boolean  @default(false) @map("is_system")
  ordem     Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  permissoes        RolePermission[]
  memberships       TenantMembership[]
  compartilhamentos ShareGrant[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("papeis")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("papel_permissoes")
}

/// Concessão ou revogação pontual de uma permissão para um usuário dentro de um tenant.
/// Sempre vence sobre o que o papel define.
model UserPermissionOverride {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  tenantId     Int              @map("tenant_id")
  permissionId Int              @map("permission_id")
  efeito       PermissionEffect
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, permissionId])
  @@index([tenantId])
  @@map("usuario_permissoes")
}

/// Vínculo de um usuário com um tenant + o papel que ele exerce ali.
/// A existência de uma linha aqui é o que define "este usuário é membro deste tenant".
model TenantMembership {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  tenantId      Int      @map("tenant_id")
  roleId        Int      @map("role_id")
  colaboradorId Int?     @map("colaborador_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  role        Role          @relation(fields: [roleId], references: [id])
  colaborador Collaborator? @relation(fields: [colaboradorId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Client {
  id                   Int      @id @default(autoincrement())
  tenantId             Int      @map("tenant_id")
  nome                 String
  razaoSocial          String?  @map("razao_social")
  cnpj                 String?
  idWhatsapp           String   @map("id_whatsapp")
  escalation           String
  telefone             String?
  site                 String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  slaMinutos           Int?     @map("sla_minutos")
  observacoes          String?
  responsavelInternoId Int?     @map("responsavel_interno_id")
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  responsavelInterno Collaborator? @relation("ClientResponsible", fields: [responsavelInternoId], references: [id])
  equipes            Team[]
  escalas            Scale[]
  plantoes           OnCall[]
  turnos             Shift[]

  @@index([tenantId])
  @@map("clientes")
}

model Team {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  nome      String
  clienteId Int?     @map("cliente_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  cliente           Client?               @relation(fields: [clienteId], references: [id])
  colaboradores     Collaborator[]
  gestores          ManagerTeam[]
  turnos            Shift[]
  compartilhamentos ShareGrant[]
  diretorioPadraoDe DirectoryConnection[] @relation("DirectoryDefaultTeam")

  @@index([tenantId])
  @@map("equipes")
}

model Collaborator {
  id             Int          @id @default(autoincrement())
  tenantId       Int          @map("tenant_id")
  nome           String
  email          String
  telefone       String
  cargo          String
  equipeId       Int          @map("equipe_id")
  tipoContrato   ContractType @map("tipo_contrato")
  modeloTrabalho WorkModel    @map("modelo_trabalho")
  fazPlantao     Boolean      @default(false) @map("faz_plantao")
  sobreAviso     Boolean      @default(false) @map("sobre_aviso")
  ativo          Boolean      @default(true)

  /// Cadastro funcional. `dataAdmissao` é opcional no banco porque os
  /// cadastros anteriores a este módulo não a têm — mas sem ela não há como
  /// calcular ciclo de férias, e a tela cobra o preenchimento.
  dataAdmissao     DateTime? @map("data_admissao") @db.Date
  dataDesligamento DateTime? @map("data_desligamento") @db.Date
  dataNascimento   DateTime? @map("data_nascimento") @db.Date
  matricula        String?
  cpf              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  equipe              Team                 @relation(fields: [equipeId], references: [id])
  clientesResponsavel Client[]             @relation("ClientResponsible")
  memberships         TenantMembership[]
  escalas             ScaleAssignment[]
  plantoes            OnCall[]
  ferias              Vacation[]
  ausencias           Absence[]
  turnos              Shift[]              @relation("ShiftOwner")
  turnosOriginais     Shift[]              @relation("ShiftOriginalOwner")
  trocasSolicitadas   ShiftSwap[]          @relation("SwapRequester")
  trocasRecebidas     ShiftSwap[]          @relation("SwapTarget")
  ajustesFerias       VacationAdjustment[]
  diretorioPessoa     DirectoryPerson?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("colaboradores")
}

model ManagerTeam {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  gestorId Int @map("gestor_id")
  equipeId Int @map("equipe_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  gestor User   @relation(fields: [gestorId], references: [id])
  equipe Team   @relation(fields: [equipeId], references: [id])

  @@unique([gestorId, equipeId])
  @@index([tenantId])
  @@map("gestor_equipes")
}

model Scale {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  nome      String
  tipo      ScaleType
  descricao String
  clienteId Int?      @map("cliente_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  cliente       Client?           @relation(fields: [clienteId], references: [id])
  colaboradores ScaleAssignment[]
  detalhes      ScaleDetail[]
  turnos        Shift[]

  @@index([tenantId])
  @@map("escalas")
}

model ScaleAssignment {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  colaboradorId Int       @map("colaborador_id")
  escalaId      Int       @map("escala_id")
  /// Posição na rotação: em 12x36 com 2 pessoas, ordem 0 e 1 se alternam.
  ordem         Int       @default(0)
  dataInicio    DateTime  @map("data_inicio") @db.Date
  dataFim       DateTime? @map("data_fim") @db.Date

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  colaborador Collaborator @relation(fields: [colaboradorId], references: [id])
  escala      Scale        @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("escala_colaboradores")
}

model ScaleDetail {
  id         Int    @id @default(autoincrement())
  tenantId   Int    @map("tenant_id")
  escalaId   Int    @map("escala_id")
  diaSemana  Int    @map("dia_semana")
  horaInicio String @map("hora_inicio")
  horaFim    String @map("hora_fim")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  escala Scale  @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("escala_detalhe")
}

/// Turno concreto: uma pessoa, um dia, um horário. É o que a operação enxerga
/// no calendário e é a unidade que pode ser trocada entre colaboradores.
model Shift {
  id                    Int         @id @default(autoincrement())
  tenantId              Int         @map("tenant_id")
  colaboradorId         Int         @map("colaborador_id")
  escalaId              Int?        @map("escala_id")
  equipeId              Int?        @map("equipe_id")
  clienteId             Int?        @map("cliente_id")
  data                  DateTime    @db.Date
  horaInicio            String      @map("hora_inicio")
  horaFim               String      @map("hora_fim")
  tipo                  ShiftType   @default(turno)
  status                ShiftStatus @default(planejado)
  observacao            String?
  /// Quem estava escalado originalmente, quando o turno veio de uma troca aprovada.
  colaboradorOriginalId Int?        @map("colaborador_original_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  colaborador         Collaborator  @relation("ShiftOwner", fields: [colaboradorId], references: [id])
  colaboradorOriginal Collaborator? @relation("ShiftOriginalOwner", fields: [colaboradorOriginalId], references: [id])
  escala              Scale?        @relation(fields: [escalaId], references: [id])
  equipe              Team?         @relation(fields: [equipeId], references: [id])
  cliente             Client?       @relation(fields: [clienteId], references: [id])
  trocasComoOrigem    ShiftSwap[]   @relation("SwapOriginShift")
  trocasComoDestino   ShiftSwap[]   @relation("SwapTargetShift")

  @@unique([colaboradorId, data, horaInicio])
  @@index([tenantId, data])
  @@map("turnos")
}

/// Pedido de troca de turno entre dois colaboradores.
/// tipo=troca: ambos trocam de dia (turno origem <-> turno destino).
/// tipo=cobertura: o destinatário assume o turno de origem, sem contrapartida.
model ShiftSwap {
  id                 Int        @id @default(autoincrement())
  tenantId           Int        @map("tenant_id")
  tipo               SwapType   @default(troca)
  solicitanteId      Int        @map("solicitante_id")
  destinatarioId     Int        @map("destinatario_id")
  turnoOrigemId      Int        @map("turno_origem_id")
  turnoDestinoId     Int?       @map("turno_destino_id")
  motivo             String
  status             SwapStatus @default(pendente)
  respondidoPorId    Int?       @map("respondido_por_id")
  respondidoEm       DateTime?  @map("respondido_em")
  observacaoResposta String?    @map("observacao_resposta")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  solicitante   Collaborator @relation("SwapRequester", fields: [solicitanteId], references: [id])
  destinatario  Collaborator @relation("SwapTarget", fields: [destinatarioId], references: [id])
  turnoOrigem   Shift        @relation("SwapOriginShift", fields: [turnoOrigemId], references: [id], onDelete: Cascade)
  turnoDestino  Shift?       @relation("SwapTargetShift", fields: [turnoDestinoId], references: [id], onDelete: Cascade)
  respondidoPor User?        @relation("SwapResponder", fields: [respondidoPorId], references: [id])

  @@index([tenantId, status])
  @@map("turno_trocas")
}

model OnCall {
  id            Int        @id @default(autoincrement())
  tenantId      Int        @map("tenant_id")
  colaboradorId Int        @map("colaborador_id")
  clienteId     Int?       @map("cliente_id")
  data          DateTime   @db.Date
  horaInicio    String     @map("hora_inicio")
  horaFim       String     @map("hora_fim")
  tipo          OnCallType

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  colaborador Collaborator @relation(fields: [colaboradorId], references: [id])
  cliente     Client?      @relation(fields: [clienteId], references: [id])

  @@index([tenantId, data])
  @@map("plantoes")
}

model Vacation {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  colaboradorId   Int            @map("colaborador_id")
  dataInicio      DateTime       @map("data_inicio") @db.Date
  dataFim         DateTime       @map("data_fim") @db.Date
  /// Qual período aquisitivo este gozo consome. Nulo em registros anteriores
  /// ao módulo de ciclos — a tela classifica pela data quando possível.
  cicloNumero     Int?           @map("ciclo_numero")
  /// Dias vendidos como abono pecuniário (Art. 143), até 1/3 do direito.
  diasAbono       Int            @default(0) @map("dias_abono")
  status          VacationStatus @default(pendente)
  observacao      String?
  solicitadoPorId Int?           @map("solicitado_por_id")
  respondidoPorId Int?           @map("respondido_por_id")
  respondidoEm    DateTime?      @map("respondido_em")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id])
  solicitadoPor User?        @relation("VacationRequester", fields: [solicitadoPorId], references: [id])
  respondidoPor User?        @relation("VacationApprover", fields: [respondidoPorId], references: [id])

  @@index([tenantId])
  /// `dataFim` fecha o índice porque é o predicado que descarta o histórico
  /// já encerrado — a maior parte da tabela.
  @@index([tenantId, status, dataFim])
  @@map("ferias")
}

model Absence {
  id              Int           @id @default(autoincrement())
  tenantId        Int           @map("tenant_id")
  colaboradorId   Int           @map("colaborador_id")
  tipo            AbsenceType
  dataInicio      DateTime      @map("data_inicio") @db.Date
  dataFim         DateTime      @map("data_fim") @db.Date
  motivo          String?
  status          AbsenceStatus @default(pendente)
  respondidoPorId Int?          @map("respondido_por_id")
  respondidoEm    DateTime?     @map("respondido_em")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id])
  respondidoPor User?        @relation("AbsenceApprover", fields: [respondidoPorId], references: [id])

  @@index([tenantId, dataInicio])
  @@index([tenantId, status, dataFim])
  @@map("ausencias")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  tenantId    Int?        @map("tenant_id")
  actorUserId Int?        @map("actor_user_id")
  actorNome   String      @map("actor_nome")
  acao        AuditAction
  entidade    String
  entidadeId  String?     @map("entidade_id")
  descricao   String?
  antes       Json?
  depois      Json?
  ip          String?
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entidade, entidadeId])
  /// Serve a paginação por cursor (ORDER BY id DESC) sem varrer as linhas
  /// dos outros tenants — ver a migration 202607262300 para a medição.
  @@index([tenantId, id(sort: Desc)])
  @@map("auditoria")
}

/// Concessão de acesso a um recurso para um destinatário.
/// O destinatário varia conforme o escopo: um usuário, uma equipe inteira,
/// todos que exercem um papel, todo o tenant, quem tiver o link público ou
/// (exclusivo do Administrador Global) todas as empresas da plataforma.
/// Só uma das colunas de destino é preenchida por linha — as demais ficam nulas.
model ShareGrant {
  id          Int               @id @default(autoincrement())
  tenantId    Int               @map("tenant_id")
  recursoTipo ShareResourceType @map("recurso_tipo")
  recursoId   Int               @map("recurso_id")
  escopo      ShareScope
  usuarioId   Int?              @map("usuario_id")
  equipeId    Int?              @map("equipe_id")
  papelId     Int?              @map("papel_id")
  token       String?           @unique
  acesso      ShareAccess       @default(leitura)
  expiraEm    DateTime?         @map("expira_em")
  criadoPorId Int?              @map("criado_por_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  usuario   User?  @relation("ShareTargetUser", fields: [usuarioId], references: [id], onDelete: Cascade)
  equipe    Team?  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  papel     Role?  @relation(fields: [papelId], references: [id], onDelete: Cascade)
  criadoPor User?  @relation("ShareCreator", fields: [criadoPorId], references: [id])

  @@index([tenantId, recursoTipo, recursoId])
  @@index([usuarioId])
  @@index([equipeId])
  @@index([papelId])
  @@map("compartilhamentos")
}

/// Dashboard montado pelo usuário. O conteúdo (lista de widgets) não fica aqui:
/// mora em DashboardVersion, e `versaoAtualId` aponta para a versão publicada.
/// Editar cria uma nova versão — o histórico nunca é sobrescrito.
model Dashboard {
  id            Int                 @id @default(autoincrement())
  tenantId      Int                 @map("tenant_id")
  nome          String
  descricao     String?
  ownerUserId   Int                 @map("owner_user_id")
  visibilidade  DashboardVisibility @default(privado)
  versaoAtualId Int?                @unique @map("versao_atual_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  owner       User                @relation("DashboardOwner", fields: [ownerUserId], references: [id])
  versaoAtual DashboardVersion?   @relation("DashboardCurrentVersion", fields: [versaoAtualId], references: [id])
  versoes     DashboardVersion[]  @relation("DashboardVersions")
  favoritos   DashboardFavorite[]

  @@index([tenantId])
  @@index([tenantId, ownerUserId])
  @@map("dashboards")
}

/// Snapshot imutável do layout (array de widgets) em um ponto do tempo.
model DashboardVersion {
  id          Int      @id @default(autoincrement())
  dashboardId Int      @map("dashboard_id")
  versao      Int
  layout      Json
  nota        String?
  criadoPorId Int?     @map("criado_por_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dashboard Dashboard  @relation("DashboardVersions", fields: [dashboardId], references: [id], onDelete: Cascade)
  criadoPor User?      @relation("DashboardVersionAuthor", fields: [criadoPorId], references: [id])
  atualDe   Dashboard? @relation("DashboardCurrentVersion")

  @@unique([dashboardId, versao])
  @@index([dashboardId])
  @@map("dashboard_versoes")
}

model DashboardFavorite {
  id          Int      @id @default(autoincrement())
  dashboardId Int      @map("dashboard_id")
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId])
  @@map("dashboard_favoritos")
}

/// Ajuste manual no direito a férias de um ciclo.
///
/// Os ciclos são derivados da data de admissão e não ficam armazenados. Esta
/// tabela guarda só o que NÃO é derivável: acordo coletivo, correção de
/// cadastro, quitação em dobro de um ciclo vencido. Todo ajuste exige motivo,
/// porque mexe em direito trabalhista e alguém vai precisar explicar depois.
model VacationAdjustment {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  colaboradorId   Int      @map("colaborador_id")
  cicloNumero     Int      @map("ciclo_numero")
  /// Positivo concede dias, negativo retira.
  diasDelta       Int      @map("dias_delta")
  motivo          String
  registradoPorId Int?     @map("registrado_por_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  registradoPor User?        @relation("VacationAdjustmentAuthor", fields: [registradoPorId], references: [id])

  @@index([tenantId, colaboradorId])
  @@map("ferias_ajustes")
}

/// Notificação dentro do app.
///
/// `chaveIdempotencia` é o que permite a varredura diária rodar quantas vezes
/// for preciso sem duplicar aviso: identifica o fato notificado (por exemplo
/// `ferias_prazo_critico:colab=12:ciclo=2`), não o instante do envio.
model Notification {
  id                Int                  @id @default(autoincrement())
  tenantId          Int                  @map("tenant_id")
  destinatarioId    Int                  @map("destinatario_id")
  tipo              NotificationType
  severidade        NotificationSeverity @default(info)
  titulo            String
  mensagem          String
  /// Para onde a notificação leva ao ser clicada.
  link              String?
  entidade          String?
  entidadeId        String?              @map("entidade_id")
  chaveIdempotencia String               @map("chave_idempotencia")
  lidaEm            DateTime?            @map("lida_em")
  createdAt         DateTime             @default(now()) @map("created_at")

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  destinatario User   @relation("NotificationTarget", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@unique([destinatarioId, chaveIdempotencia])
  /// Serve a consulta quente: as não lidas de quem está com a tela aberta.
  @@index([destinatarioId, lidaEm, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("notificacoes")
}

// ============================================================================
// MÓDULO DE DIRETÓRIO (sincronização organizacional)
// ============================================================================
//
// Tudo aqui é ESPELHO do provedor de identidade (Entra ID hoje; Google, Okta
// e LDAP depois). O motor de sincronização escreve exclusivamente nestas
// tabelas — nunca em colaboradores, equipes, escalas, turnos, férias ou
// qualquer outra tabela operacional.
//
// A única ponte entre os dois mundos é `DirectoryPerson.colaboradorId`, e
// atravessá-la é ato explícito da reconciliação, com lista fechada de campos.
// Por isso um diretório de 5.000 contas não vira 5.000 colaboradores: entra
// tudo no espelho (barato, isolado), e virar colaborador é decisão de quem
// opera.

enum DirectoryProviderType {
  entra
  google
  okta
  ldap
}

enum DirectorySyncMode {
  completa
  incremental
}

enum DirectorySyncStatus {
  executando
  sucesso
  parcial
  erro
}

enum DirectorySyncLevel {
  info
  aviso
  erro
}

/// Conexão com um provedor de identidade, por empresa.
///
/// As credenciais moram aqui, e não no ambiente, porque cada empresa do SaaS
/// tem o próprio tenant Entra e a própria App Registration — credencial em
/// `.env` limitaria a plataforma inteira a um único cliente. O segredo é
/// gravado cifrado (AES-256-GCM) com uma chave que fica no ambiente: um dump
/// do banco, sozinho, não entrega segredo nenhum.
model DirectoryConnection {
  id       Int                   @id @default(autoincrement())
  tenantId Int                   @map("tenant_id")
  provider DirectoryProviderType @default(entra)
  nome     String
  ativo    Boolean               @default(false)

  /// Identificador do tenant NO PROVEDOR (o `ENTRA_TENANT_ID` do cliente) —
  /// não confundir com `tenantId`, que é a empresa dentro desta aplicação.
  provedorTenantId    String  @map("provedor_tenant_id")
  clientId            String  @map("client_id")
  clientSecretCifrado String  @map("client_secret_cifrado")
  /// Sobrescreve a authority padrão do ambiente (nuvens soberanas, testes).
  authorityUrl        String? @map("authority_url")

  /// Flags de sincronização por empresa: o que sincronizar, se cria e desativa
  /// colaborador automaticamente, padrões de país/fuso/idioma, verbosidade do
  /// log. Os valores do ambiente entram como padrão quando a chave falta.
  opcoes Json

  /// Equipe de entrada para colaborador criado automaticamente.
  /// Obrigatória quando `autoCriarColaboradores` está ligada, porque
  /// `colaboradores.equipe_id` é NOT NULL e o diretório não conhece equipes.
  equipePadraoId Int? @map("equipe_padrao_id")

  /// Cursor OPACO de sincronização incremental. Cada provedor guarda o que
  /// precisar: deltaLink no Entra, syncToken no Google, modifyTimestamp no
  /// LDAP. O motor nunca interpreta o conteúdo.
  cursorPessoas String? @map("cursor_pessoas")
  cursorGrupos  String? @map("cursor_grupos")

  ultimaSincronizacaoEm DateTime? @map("ultima_sincronizacao_em")
  ultimoTesteEm         DateTime? @map("ultimo_teste_em")
  ultimoTesteOk         Boolean?  @map("ultimo_teste_ok")
  ultimoErro            String?   @map("ultimo_erro")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  equipePadrao  Team?                 @relation("DirectoryDefaultTeam", fields: [equipePadraoId], references: [id])
  pessoas       DirectoryPerson[]
  departamentos DirectoryDepartment[]
  cargos        DirectoryJobTitle[]
  execucoes     DirectorySyncRun[]

  /// Uma conexão por provedor por empresa — abre espaço para uma empresa ter
  /// Entra e Google ao mesmo tempo sem mudar o modelo.
  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("diretorio_conexoes")
}

/// Pessoa como o provedor a descreve. Réplica, não cadastro.
model DirectoryPerson {
  id           Int @id @default(autoincrement())
  tenantId     Int @map("tenant_id")
  connectionId Int @map("connection_id")

  /// Object ID do provedor — a chave de vínculo. Nunca e-mail ou nome, que
  /// mudam ao longo do tempo e reapontariam o vínculo para a pessoa errada.
  externalId String @map("external_id")

  nomeExibicao      String  @map("nome_exibicao")
  primeiroNome      String? @map("primeiro_nome")
  sobrenome         String?
  email             String?
  userPrincipalName String? @map("user_principal_name")
  cargo             String?
  departamento      String?
  empresa           String?
  escritorio        String?
  telefone          String?
  celular           String?
  pais              String?
  cidade            String?
  estado            String?
  idioma            String?
  fusoHorario       String? @map("fuso_horario")
  contaHabilitada   Boolean @default(true) @map("conta_habilitada")

  /// Gestor NO DIRETÓRIO: pessoa → pessoa, hierarquia de RH.
  /// Não confundir com `gestor_equipes`, que é usuário → equipe e responde
  /// pela operação. Os dois não são deriváveis um do outro.
  gestorExternalId String? @map("gestor_external_id")

  fotoEtag         String?   @map("foto_etag")
  fotoAtualizadaEm DateTime? @map("foto_atualizada_em")

  /// A ponte para o mundo operacional. Nulo é o caso normal: a maior parte
  /// das contas de um diretório corporativo não é da operação.
  colaboradorId Int? @unique @map("colaborador_id")

  /// Campos que a sincronização não pode sobrescrever neste vínculo — a
  /// válvula para quando o diretório está errado e o cadastro está certo.
  camposBloqueados String[] @default([]) @map("campos_bloqueados")

  /// Payload cru do provedor, para diagnosticar divergência sem reconsultar.
  bruto Json?

  /// Preenchido quando o objeto some do diretório. Nunca apagamos a linha:
  /// o histórico operacional referencia essa pessoa.
  removidoEm    DateTime? @map("removido_em")
  primeiraVezEm DateTime  @default(now()) @map("primeira_vez_em")
  ultimaVezEm   DateTime  @default(now()) @map("ultima_vez_em")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  conexao     DirectoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  colaborador Collaborator?       @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([tenantId])
  @@index([connectionId, departamento])
  @@index([connectionId, gestorExternalId])
  @@map("diretorio_pessoas")
}

/// Catálogo de departamentos, DERIVADO dos valores distintos de `department`.
///
/// No Microsoft Graph departamento não é objeto: é string livre no usuário,
/// e não existe endpoint `/departments`. Então "departamento deixou de
/// existir" significa "nenhuma pessoa ativa referencia mais essa string" — e
/// o efeito é marcar inativo, nunca apagar.
///
/// Como é string livre, erro de digitação no diretório vira departamento novo.
/// `mescladoEmId` permite unificar dois registros sem perder o histórico de
/// qual grafia veio do provedor.
model DirectoryDepartment {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  connectionId Int     @map("connection_id")
  nome         String
  ativo        Boolean @default(true)
  /// Quantas pessoas ativas referenciavam este departamento na última execução.
  pessoas      Int     @default(0)

  mescladoEmId Int? @map("mesclado_em_id")

  primeiraVezEm DateTime @default(now()) @map("primeira_vez_em")
  ultimaVezEm   DateTime @default(now()) @map("ultima_vez_em")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  conexao    DirectoryConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mescladoEm DirectoryDepartment?  @relation("DepartmentMerge", fields: [mescladoEmId], references: [id])
  mesclados  DirectoryDepartment[] @relation("DepartmentMerge")

  @@unique([connectionId, nome])
  @@index([tenantId])
  @@map("diretorio_departamentos")
}

/// Catálogo de cargos, derivado de `jobTitle` pela mesma razão acima.
/// Informativo por definição: cargo nunca controla permissão nesta aplicação
/// — quem controla é o papel (RBAC), atribuído dentro do sistema.
model DirectoryJobTitle {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  connectionId Int     @map("connection_id")
  nome         String
  ativo        Boolean @default(true)
  pessoas      Int     @default(0)

  primeiraVezEm DateTime @default(now()) @map("primeira_vez_em")
  ultimaVezEm   DateTime @default(now()) @map("ultima_vez_em")

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  conexao DirectoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, nome])
  @@index([tenantId])
  @@map("diretorio_cargos")
}

/// Uma execução da sincronização. É o registro que responde "o que aconteceu
/// às 3h da manhã" sem depender de log de aplicação.
model DirectorySyncRun {
  id           Int                 @id @default(autoincrement())
  tenantId     Int                 @map("tenant_id")
  connectionId Int                 @map("connection_id")
  modo         DirectorySyncMode
  status       DirectorySyncStatus @default(executando)

  /// Nulo quando quem disparou foi o agendador.
  disparadoPorId Int? @map("disparado_por_id")

  objetosLidos       Int @default(0) @map("objetos_lidos")
  objetosCriados     Int @default(0) @map("objetos_criados")
  objetosAtualizados Int @default(0) @map("objetos_atualizados")
  objetosInalterados Int @default(0) @map("objetos_inalterados")
  objetosRemovidos   Int @default(0) @map("objetos_removidos")
  conflitos          Int @default(0)

  /// Contagens por entidade e qualquer métrica específica do provedor.
  detalhes Json?
  erro     String?

  iniciadoEm   DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm DateTime? @map("finalizado_em")

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  conexao      DirectoryConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  disparadoPor User?                @relation("DirectorySyncTrigger", fields: [disparadoPorId], references: [id], onDelete: SetNull)
  eventos      DirectorySyncEvent[]

  @@index([tenantId, iniciadoEm(sort: Desc)])
  @@index([connectionId, iniciadoEm(sort: Desc)])
  @@map("diretorio_execucoes")
}

/// Registro por objeto dentro de uma execução: o que mudou, o que foi pulado
/// e por quê. Fica separado de `auditoria` de propósito — misturar milhares
/// de linhas de robô com o rastro de ações humanas inutilizaria as duas.
/// Volume controlado pela flag `logOperacoes` da conexão + poda por retenção.
model DirectorySyncEvent {
  id         Int                @id @default(autoincrement())
  runId      Int                @map("run_id")
  nivel      DirectorySyncLevel @default(info)
  entidade   String
  externalId String?            @map("external_id")
  acao       String
  mensagem   String
  dados      Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  execucao DirectorySyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, nivel])
  @@map("diretorio_execucao_eventos")
}
