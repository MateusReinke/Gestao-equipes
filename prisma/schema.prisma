generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  clt
  pj
  terceirizado
  estagio
}

enum WorkModel {
  presencial
  hibrido
  remoto
}

enum ScaleType {
  doze_por_trinta_seis
  cinco_por_dois
  personalizada
}

enum OnCallType {
  plantao
  sobreaviso
}

enum VacationStatus {
  pendente
  aprovado
  rejeitado
  cancelado
}

enum ShiftType {
  turno
  plantao
  sobreaviso
}

enum ShiftStatus {
  planejado
  confirmado
  trocado
  cancelado
}

enum SwapType {
  troca
  cobertura
}

enum SwapStatus {
  pendente
  aceito_pelo_par
  aprovado
  rejeitado
  cancelado
}

enum AbsenceType {
  falta
  atestado
  licenca
  folga
  banco_horas
  outro
}

enum AbsenceStatus {
  pendente
  aprovado
  rejeitado
}

enum PermissionEffect {
  grant
  deny
}

/// Tipos de recurso que podem ser compartilhados.
enum ShareResourceType {
  dashboard
  escala
  relatorio
}

/// Para quem o recurso foi compartilhado.
enum ShareScope {
  usuario
  equipe
  papel
  tenant
  link_publico
  plataforma
}

/// Quanto o destinatário pode fazer com o recurso compartilhado.
enum ShareAccess {
  leitura
  edicao
  gestao
}

enum DashboardVisibility {
  privado
  compartilhado
}

enum NotificationSeverity {
  info
  aviso
  critico
}

enum NotificationType {
  ferias_direito_adquirido
  ferias_prazo_proximo
  ferias_prazo_critico
  ferias_vencida
  ferias_pendente_aprovacao
  ausencia_pendente_aprovacao
  troca_pendente_aprovacao
}

enum AuditAction {
  create
  update
  delete
  login
  login_failed
  permission_change
  swap_request
  swap_response
}

model Tenant {
  id        Int      @id @default(autoincrement())
  nome      String
  slug      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       TenantMembership[]
  papeis            Role[]
  overrides         UserPermissionOverride[]
  clientes          Client[]
  equipes           Team[]
  colaboradores     Collaborator[]
  gestorEquipes     ManagerTeam[]
  escalas           Scale[]
  escalaAtribuicoes ScaleAssignment[]
  escalaDetalhes    ScaleDetail[]
  plantoes          OnCall[]
  turnos            Shift[]
  trocas            ShiftSwap[]
  ferias            Vacation[]
  ausencias         Absence[]
  auditoria         AuditLog[]
  compartilhamentos ShareGrant[]
  dashboards        Dashboard[]
  ajustesFerias     VacationAdjustment[]
  notificacoes      Notification[]

  @@map("tenants")
}

/// Identidade global do usuário (um único login/e-mail na plataforma).
/// O vínculo com cada tenant - e o papel dentro dele - vive em TenantMembership.
/// isGlobalAdmin marca o Administrador Global (escopo de plataforma, não depende de vínculo).
model User {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  senhaHash     String   @map("senha_hash")
  ativo         Boolean  @default(true)
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships                TenantMembership[]
  gestorEquipes              ManagerTeam[]
  overrides                  UserPermissionOverride[]
  auditoria                  AuditLog[]
  feriasSolicitadas          Vacation[]               @relation("VacationRequester")
  feriasRespondidas          Vacation[]               @relation("VacationApprover")
  ausenciasRespondidas       Absence[]                @relation("AbsenceApprover")
  trocasRespondidas          ShiftSwap[]              @relation("SwapResponder")
  compartilhamentosRecebidos ShareGrant[]             @relation("ShareTargetUser")
  compartilhamentosCriados   ShareGrant[]             @relation("ShareCreator")
  dashboards                 Dashboard[]              @relation("DashboardOwner")
  dashboardVersoes           DashboardVersion[]       @relation("DashboardVersionAuthor")
  dashboardFavoritos         DashboardFavorite[]
  notificacoes               Notification[]           @relation("NotificationTarget")
  ajustesFeriasRegistrados   VacationAdjustment[]     @relation("VacationAdjustmentAuthor")

  @@map("usuarios")
}

/// Catálogo global e imutável de permissões nomeadas da plataforma.
model Permission {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  categoria String

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([categoria])
  @@map("permissoes")
}

/// Papel (cargo). tenantId nulo = papel de sistema, disponível para todos os tenants.
/// tenantId preenchido = papel customizado criado por aquele tenant.
model Role {
  id        Int      @id @default(autoincrement())
  tenantId  Int?     @map("tenant_id")
  codigo    String
  nome      String
  descricao String
  isSystem  Boolean  @default(false) @map("is_system")
  ordem     Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  permissoes        RolePermission[]
  memberships       TenantMembership[]
  compartilhamentos ShareGrant[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("papeis")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("papel_permissoes")
}

/// Concessão ou revogação pontual de uma permissão para um usuário dentro de um tenant.
/// Sempre vence sobre o que o papel define.
model UserPermissionOverride {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  tenantId     Int              @map("tenant_id")
  permissionId Int              @map("permission_id")
  efeito       PermissionEffect
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, permissionId])
  @@index([tenantId])
  @@map("usuario_permissoes")
}

/// Vínculo de um usuário com um tenant + o papel que ele exerce ali.
/// A existência de uma linha aqui é o que define "este usuário é membro deste tenant".
model TenantMembership {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  tenantId      Int      @map("tenant_id")
  roleId        Int      @map("role_id")
  colaboradorId Int?     @map("colaborador_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  role        Role          @relation(fields: [roleId], references: [id])
  colaborador Collaborator? @relation(fields: [colaboradorId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Client {
  id                   Int      @id @default(autoincrement())
  tenantId             Int      @map("tenant_id")
  nome                 String
  razaoSocial          String?  @map("razao_social")
  cnpj                 String?
  idWhatsapp           String   @map("id_whatsapp")
  escalation           String
  telefone             String?
  site                 String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String?
  slaMinutos           Int?     @map("sla_minutos")
  observacoes          String?
  responsavelInternoId Int?     @map("responsavel_interno_id")
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  responsavelInterno Collaborator? @relation("ClientResponsible", fields: [responsavelInternoId], references: [id])
  equipes            Team[]
  escalas            Scale[]
  plantoes           OnCall[]
  turnos             Shift[]

  @@index([tenantId])
  @@map("clientes")
}

model Team {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  nome      String
  clienteId Int?     @map("cliente_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  cliente           Client?        @relation(fields: [clienteId], references: [id])
  colaboradores     Collaborator[]
  gestores          ManagerTeam[]
  turnos            Shift[]
  compartilhamentos ShareGrant[]

  @@index([tenantId])
  @@map("equipes")
}

model Collaborator {
  id             Int          @id @default(autoincrement())
  tenantId       Int          @map("tenant_id")
  nome           String
  email          String
  telefone       String
  cargo          String
  equipeId       Int          @map("equipe_id")
  tipoContrato   ContractType @map("tipo_contrato")
  modeloTrabalho WorkModel    @map("modelo_trabalho")
  fazPlantao     Boolean      @default(false) @map("faz_plantao")
  sobreAviso     Boolean      @default(false) @map("sobre_aviso")
  ativo          Boolean      @default(true)

  /// Cadastro funcional. `dataAdmissao` é opcional no banco porque os
  /// cadastros anteriores a este módulo não a têm — mas sem ela não há como
  /// calcular ciclo de férias, e a tela cobra o preenchimento.
  dataAdmissao     DateTime? @map("data_admissao") @db.Date
  dataDesligamento DateTime? @map("data_desligamento") @db.Date
  dataNascimento   DateTime? @map("data_nascimento") @db.Date
  matricula        String?
  cpf              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  equipe              Team                 @relation(fields: [equipeId], references: [id])
  clientesResponsavel Client[]             @relation("ClientResponsible")
  memberships         TenantMembership[]
  escalas             ScaleAssignment[]
  plantoes            OnCall[]
  ferias              Vacation[]
  ausencias           Absence[]
  turnos              Shift[]              @relation("ShiftOwner")
  turnosOriginais     Shift[]              @relation("ShiftOriginalOwner")
  trocasSolicitadas   ShiftSwap[]          @relation("SwapRequester")
  trocasRecebidas     ShiftSwap[]          @relation("SwapTarget")
  ajustesFerias       VacationAdjustment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("colaboradores")
}

model ManagerTeam {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  gestorId Int @map("gestor_id")
  equipeId Int @map("equipe_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  gestor User   @relation(fields: [gestorId], references: [id])
  equipe Team   @relation(fields: [equipeId], references: [id])

  @@unique([gestorId, equipeId])
  @@index([tenantId])
  @@map("gestor_equipes")
}

model Scale {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  nome      String
  tipo      ScaleType
  descricao String
  clienteId Int?      @map("cliente_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  cliente       Client?           @relation(fields: [clienteId], references: [id])
  colaboradores ScaleAssignment[]
  detalhes      ScaleDetail[]
  turnos        Shift[]

  @@index([tenantId])
  @@map("escalas")
}

model ScaleAssignment {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  colaboradorId Int       @map("colaborador_id")
  escalaId      Int       @map("escala_id")
  /// Posição na rotação: em 12x36 com 2 pessoas, ordem 0 e 1 se alternam.
  ordem         Int       @default(0)
  dataInicio    DateTime  @map("data_inicio") @db.Date
  dataFim       DateTime? @map("data_fim") @db.Date

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  colaborador Collaborator @relation(fields: [colaboradorId], references: [id])
  escala      Scale        @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("escala_colaboradores")
}

model ScaleDetail {
  id         Int    @id @default(autoincrement())
  tenantId   Int    @map("tenant_id")
  escalaId   Int    @map("escala_id")
  diaSemana  Int    @map("dia_semana")
  horaInicio String @map("hora_inicio")
  horaFim    String @map("hora_fim")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  escala Scale  @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("escala_detalhe")
}

/// Turno concreto: uma pessoa, um dia, um horário. É o que a operação enxerga
/// no calendário e é a unidade que pode ser trocada entre colaboradores.
model Shift {
  id                    Int         @id @default(autoincrement())
  tenantId              Int         @map("tenant_id")
  colaboradorId         Int         @map("colaborador_id")
  escalaId              Int?        @map("escala_id")
  equipeId              Int?        @map("equipe_id")
  clienteId             Int?        @map("cliente_id")
  data                  DateTime    @db.Date
  horaInicio            String      @map("hora_inicio")
  horaFim               String      @map("hora_fim")
  tipo                  ShiftType   @default(turno)
  status                ShiftStatus @default(planejado)
  observacao            String?
  /// Quem estava escalado originalmente, quando o turno veio de uma troca aprovada.
  colaboradorOriginalId Int?        @map("colaborador_original_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  colaborador         Collaborator  @relation("ShiftOwner", fields: [colaboradorId], references: [id])
  colaboradorOriginal Collaborator? @relation("ShiftOriginalOwner", fields: [colaboradorOriginalId], references: [id])
  escala              Scale?        @relation(fields: [escalaId], references: [id])
  equipe              Team?         @relation(fields: [equipeId], references: [id])
  cliente             Client?       @relation(fields: [clienteId], references: [id])
  trocasComoOrigem    ShiftSwap[]   @relation("SwapOriginShift")
  trocasComoDestino   ShiftSwap[]   @relation("SwapTargetShift")

  @@unique([colaboradorId, data, horaInicio])
  @@index([tenantId, data])
  @@map("turnos")
}

/// Pedido de troca de turno entre dois colaboradores.
/// tipo=troca: ambos trocam de dia (turno origem <-> turno destino).
/// tipo=cobertura: o destinatário assume o turno de origem, sem contrapartida.
model ShiftSwap {
  id                 Int        @id @default(autoincrement())
  tenantId           Int        @map("tenant_id")
  tipo               SwapType   @default(troca)
  solicitanteId      Int        @map("solicitante_id")
  destinatarioId     Int        @map("destinatario_id")
  turnoOrigemId      Int        @map("turno_origem_id")
  turnoDestinoId     Int?       @map("turno_destino_id")
  motivo             String
  status             SwapStatus @default(pendente)
  respondidoPorId    Int?       @map("respondido_por_id")
  respondidoEm       DateTime?  @map("respondido_em")
  observacaoResposta String?    @map("observacao_resposta")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  solicitante   Collaborator @relation("SwapRequester", fields: [solicitanteId], references: [id])
  destinatario  Collaborator @relation("SwapTarget", fields: [destinatarioId], references: [id])
  turnoOrigem   Shift        @relation("SwapOriginShift", fields: [turnoOrigemId], references: [id], onDelete: Cascade)
  turnoDestino  Shift?       @relation("SwapTargetShift", fields: [turnoDestinoId], references: [id], onDelete: Cascade)
  respondidoPor User?        @relation("SwapResponder", fields: [respondidoPorId], references: [id])

  @@index([tenantId, status])
  @@map("turno_trocas")
}

model OnCall {
  id            Int        @id @default(autoincrement())
  tenantId      Int        @map("tenant_id")
  colaboradorId Int        @map("colaborador_id")
  clienteId     Int?       @map("cliente_id")
  data          DateTime   @db.Date
  horaInicio    String     @map("hora_inicio")
  horaFim       String     @map("hora_fim")
  tipo          OnCallType

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  colaborador Collaborator @relation(fields: [colaboradorId], references: [id])
  cliente     Client?      @relation(fields: [clienteId], references: [id])

  @@index([tenantId, data])
  @@map("plantoes")
}

model Vacation {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  colaboradorId   Int            @map("colaborador_id")
  dataInicio      DateTime       @map("data_inicio") @db.Date
  dataFim         DateTime       @map("data_fim") @db.Date
  /// Qual período aquisitivo este gozo consome. Nulo em registros anteriores
  /// ao módulo de ciclos — a tela classifica pela data quando possível.
  cicloNumero     Int?           @map("ciclo_numero")
  /// Dias vendidos como abono pecuniário (Art. 143), até 1/3 do direito.
  diasAbono       Int            @default(0) @map("dias_abono")
  status          VacationStatus @default(pendente)
  observacao      String?
  solicitadoPorId Int?           @map("solicitado_por_id")
  respondidoPorId Int?           @map("respondido_por_id")
  respondidoEm    DateTime?      @map("respondido_em")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id])
  solicitadoPor User?        @relation("VacationRequester", fields: [solicitadoPorId], references: [id])
  respondidoPor User?        @relation("VacationApprover", fields: [respondidoPorId], references: [id])

  @@index([tenantId])
  /// `dataFim` fecha o índice porque é o predicado que descarta o histórico
  /// já encerrado — a maior parte da tabela.
  @@index([tenantId, status, dataFim])
  @@map("ferias")
}

model Absence {
  id              Int           @id @default(autoincrement())
  tenantId        Int           @map("tenant_id")
  colaboradorId   Int           @map("colaborador_id")
  tipo            AbsenceType
  dataInicio      DateTime      @map("data_inicio") @db.Date
  dataFim         DateTime      @map("data_fim") @db.Date
  motivo          String?
  status          AbsenceStatus @default(pendente)
  respondidoPorId Int?          @map("respondido_por_id")
  respondidoEm    DateTime?     @map("respondido_em")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id])
  respondidoPor User?        @relation("AbsenceApprover", fields: [respondidoPorId], references: [id])

  @@index([tenantId, dataInicio])
  @@index([tenantId, status, dataFim])
  @@map("ausencias")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  tenantId    Int?        @map("tenant_id")
  actorUserId Int?        @map("actor_user_id")
  actorNome   String      @map("actor_nome")
  acao        AuditAction
  entidade    String
  entidadeId  String?     @map("entidade_id")
  descricao   String?
  antes       Json?
  depois      Json?
  ip          String?
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entidade, entidadeId])
  /// Serve a paginação por cursor (ORDER BY id DESC) sem varrer as linhas
  /// dos outros tenants — ver a migration 202607262300 para a medição.
  @@index([tenantId, id(sort: Desc)])
  @@map("auditoria")
}

/// Concessão de acesso a um recurso para um destinatário.
/// O destinatário varia conforme o escopo: um usuário, uma equipe inteira,
/// todos que exercem um papel, todo o tenant, quem tiver o link público ou
/// (exclusivo do Administrador Global) todas as empresas da plataforma.
/// Só uma das colunas de destino é preenchida por linha — as demais ficam nulas.
model ShareGrant {
  id          Int               @id @default(autoincrement())
  tenantId    Int               @map("tenant_id")
  recursoTipo ShareResourceType @map("recurso_tipo")
  recursoId   Int               @map("recurso_id")
  escopo      ShareScope
  usuarioId   Int?              @map("usuario_id")
  equipeId    Int?              @map("equipe_id")
  papelId     Int?              @map("papel_id")
  token       String?           @unique
  acesso      ShareAccess       @default(leitura)
  expiraEm    DateTime?         @map("expira_em")
  criadoPorId Int?              @map("criado_por_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  usuario   User?  @relation("ShareTargetUser", fields: [usuarioId], references: [id], onDelete: Cascade)
  equipe    Team?  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  papel     Role?  @relation(fields: [papelId], references: [id], onDelete: Cascade)
  criadoPor User?  @relation("ShareCreator", fields: [criadoPorId], references: [id])

  @@index([tenantId, recursoTipo, recursoId])
  @@index([usuarioId])
  @@index([equipeId])
  @@index([papelId])
  @@map("compartilhamentos")
}

/// Dashboard montado pelo usuário. O conteúdo (lista de widgets) não fica aqui:
/// mora em DashboardVersion, e `versaoAtualId` aponta para a versão publicada.
/// Editar cria uma nova versão — o histórico nunca é sobrescrito.
model Dashboard {
  id            Int                 @id @default(autoincrement())
  tenantId      Int                 @map("tenant_id")
  nome          String
  descricao     String?
  ownerUserId   Int                 @map("owner_user_id")
  visibilidade  DashboardVisibility @default(privado)
  versaoAtualId Int?                @unique @map("versao_atual_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  owner       User                @relation("DashboardOwner", fields: [ownerUserId], references: [id])
  versaoAtual DashboardVersion?   @relation("DashboardCurrentVersion", fields: [versaoAtualId], references: [id])
  versoes     DashboardVersion[]  @relation("DashboardVersions")
  favoritos   DashboardFavorite[]

  @@index([tenantId])
  @@index([tenantId, ownerUserId])
  @@map("dashboards")
}

/// Snapshot imutável do layout (array de widgets) em um ponto do tempo.
model DashboardVersion {
  id          Int      @id @default(autoincrement())
  dashboardId Int      @map("dashboard_id")
  versao      Int
  layout      Json
  nota        String?
  criadoPorId Int?     @map("criado_por_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dashboard Dashboard  @relation("DashboardVersions", fields: [dashboardId], references: [id], onDelete: Cascade)
  criadoPor User?      @relation("DashboardVersionAuthor", fields: [criadoPorId], references: [id])
  atualDe   Dashboard? @relation("DashboardCurrentVersion")

  @@unique([dashboardId, versao])
  @@index([dashboardId])
  @@map("dashboard_versoes")
}

model DashboardFavorite {
  id          Int      @id @default(autoincrement())
  dashboardId Int      @map("dashboard_id")
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId])
  @@map("dashboard_favoritos")
}

/// Ajuste manual no direito a férias de um ciclo.
///
/// Os ciclos são derivados da data de admissão e não ficam armazenados. Esta
/// tabela guarda só o que NÃO é derivável: acordo coletivo, correção de
/// cadastro, quitação em dobro de um ciclo vencido. Todo ajuste exige motivo,
/// porque mexe em direito trabalhista e alguém vai precisar explicar depois.
model VacationAdjustment {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  colaboradorId   Int      @map("colaborador_id")
  cicloNumero     Int      @map("ciclo_numero")
  /// Positivo concede dias, negativo retira.
  diasDelta       Int      @map("dias_delta")
  motivo          String
  registradoPorId Int?     @map("registrado_por_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  colaborador   Collaborator @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  registradoPor User?        @relation("VacationAdjustmentAuthor", fields: [registradoPorId], references: [id])

  @@index([tenantId, colaboradorId])
  @@map("ferias_ajustes")
}

/// Notificação dentro do app.
///
/// `chaveIdempotencia` é o que permite a varredura diária rodar quantas vezes
/// for preciso sem duplicar aviso: identifica o fato notificado (por exemplo
/// `ferias_prazo_critico:colab=12:ciclo=2`), não o instante do envio.
model Notification {
  id                Int                  @id @default(autoincrement())
  tenantId          Int                  @map("tenant_id")
  destinatarioId    Int                  @map("destinatario_id")
  tipo              NotificationType
  severidade        NotificationSeverity @default(info)
  titulo            String
  mensagem          String
  /// Para onde a notificação leva ao ser clicada.
  link              String?
  entidade          String?
  entidadeId        String?              @map("entidade_id")
  chaveIdempotencia String               @map("chave_idempotencia")
  lidaEm            DateTime?            @map("lida_em")
  createdAt         DateTime             @default(now()) @map("created_at")

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  destinatario User   @relation("NotificationTarget", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@unique([destinatarioId, chaveIdempotencia])
  /// Serve a consulta quente: as não lidas de quem está com a tela aberta.
  @@index([destinatarioId, lidaEm, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("notificacoes")
}
