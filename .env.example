# Banco (usado pelo serviço postgres e pelo backend)
POSTGRES_USER=gestao
POSTGRES_PASSWORD=gestao123
POSTGRES_DB=gestao_escalas
POSTGRES_PORT=55432

# Backend
DATABASE_URL=postgresql://gestao:gestao123@postgres:5432/gestao_escalas?schema=public
APP_PORT=4000
BACKEND_PORT=54000
NODE_ENV=production
# Obrigatório: gere um segredo forte (ex.: `openssl rand -hex 32`). O backend recusa subir sem isso.
JWT_SECRET=

# Origens liberadas para chamar a API direto do navegador, separadas por vírgula.
# Vazio (padrão) = nenhuma. O frontend fala com a API pelo servidor, então só
# preencha se for expor a API a um cliente externo.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Diretório (sincronização organizacional com Microsoft Entra ID)
# ---------------------------------------------------------------------------
# Desligado por padrão. Com ENABLE_ENTRA_SYNC=false as rotas respondem 503 e
# a tela avisa que o módulo não está habilitado neste ambiente.
ENABLE_ENTRA_SYNC=false

# Chave mestra que cifra o client secret de cada empresa antes de gravar no
# banco. Gere com `openssl rand -base64 32`. Também aceita 32 bytes em hex ou
# uma frase de no mínimo 32 caracteres.
#
# ATENÇÃO: trocar esta chave torna ilegíveis os segredos já gravados — a tela
# passa a pedir o recadastro de cada conexão. Guarde-a junto do JWT_SECRET.
DIRECTORY_ENCRYPTION_KEY=

# Endpoints do provedor. Só mude em nuvem soberana (ex.: Azure Government)
# ou para apontar a um ambiente de teste.
GRAPH_API_BASE_URL=https://graph.microsoft.com
GRAPH_API_VERSION=v1.0
ENTRA_AUTHORITY_URL=https://login.microsoftonline.com

# As credenciais (tenant, client id e secret) NÃO ficam aqui: são configuração
# por empresa e moram no banco, cifradas, porque cada cliente do SaaS tem o
# próprio tenant Entra. Cadastre-as na tela Administração > Diretório.

# Padrões das flags de sincronização. Cada empresa ajusta as suas na tela;
# estes valores são só o ponto de partida de uma conexão nova.
SYNC_INTERVAL_MINUTES=60
SYNC_USERS=true
SYNC_DEPARTMENTS=true
SYNC_JOB_TITLES=true
SYNC_MANAGERS=true
SYNC_GROUPS=false
# Uma requisição por pessoa: ligue só quando fizer diferença.
SYNC_PHOTOS=false
# Conta desabilitada continua no espelho — sumir com ela apagaria o nome de
# quem aparece no histórico de escalas.
SYNC_DISABLED_USERS=true
# As duas únicas flags que alcançam dado operacional. Desligadas por padrão.
AUTO_CREATE_USERS=false
AUTO_DISABLE_USERS=false
LOG_SYNC_OPERATIONS=true
FULL_SYNC_ON_FIRST_RUN=true
DEFAULT_COUNTRY=BR
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# Seed inicial (idempotente: só cria dados se o admin ainda não existir)
# SEED_ON_BOOT=true faz o backend rodar o seed automaticamente a cada subida do container.
# Deixe false/ausente e rode `npm run seed` manualmente quando preferir.
SEED_ON_BOOT=false
SEED_ADMIN_EMAIL=admin@gestao.local
SEED_ADMIN_PASSWORD=Admin@123

# Frontend (aberto na porta 4333 ao fazer deploy)
FRONTEND_PORT=4333
PORT=4333
# URL interna entre containers (Next server-side -> backend)
API_INTERNAL_URL=http://backend:4000
# Para testes com deploy simples no Coolify, mantenha igual à URL interna
NEXT_PUBLIC_API_URL=http://backend:4000
